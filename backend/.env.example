SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720
DATABASE_URL=sqlite:///./gallery.db
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:5173

# First admin, created on startup if no users exist
BOOTSTRAP_ADMIN_EMAIL=admin@churchgallery.org
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Upload limits
MAX_UPLOAD_MB=7168
MAX_UNCOMPRESSED_MB=7168
MAX_FILES_PER_ZIP=5000

# Local semantic photo search
VISUAL_SEARCH_MODEL=openai/clip-vit-base-patch32

# Google Drive
DRIVE_ENABLED=false
DRIVE_AUTH=oauth
GOOGLE_OAUTH_TOKEN_FILE=credentials/drive-token.json
GOOGLE_DRIVE_FOLDER_NAME=Church Media Gallery
# Only for DRIVE_AUTH=service_account (Shared Drive):
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
